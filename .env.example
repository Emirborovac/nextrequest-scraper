# Copy to .env and fill in. Loaded automatically by app.py / run.py / export.py.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini          # or gpt-4o-mini (cheaper)
SEED_DAYS=2                      # backfill window on first run (start small; 15 = ~weeks of data)

# Optional:
# NR_PROXY=http://user:pass@us-proxy-host:port  # REQUIRED if host is not in the US (NextRequest is US-only)
# NR_BASE=https://oaklandca.nextrequest.com   # any NextRequest agency subdomain
# NR_SEARCH=redacted                          # result stream to monitor ("" = all docs)
# POLL_SECONDS=7200                           # poll interval (default 2h)
# PORT=8080                                   # dashboard port
# RUN_MONITOR=1                               # 0 = UI only, no scraping
